{
  "name": "aigrid",
  "version": "0.2.1",
  "description": "AiGrid: browser JavaScript and React data grid with editing, change tracking, validation, sorting, filtering, grouping, tree, virtual scrolling and CSV/Excel export (freeware)",
  "keywords": [
    "data-grid",
    "datagrid",
    "grid",
    "data-table",
    "table",
    "editable-table",
    "spreadsheet",
    "react",
    "react-component",
    "javascript",
    "typescript",
    "virtual-scroll",
    "sorting",
    "filtering",
    "grouping",
    "tree-grid",
    "pagination",
    "excel",
    "csv",
    "change-tracking",
    "validation",
    "korean"
  ],
  "homepage": "https://rubyon.azurewebsites.net/software/aigrid",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "author": "Rubyonsoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubyonsoft/DataGridAI.git"
  },
  "sideEffects": [
    "./dist/aigrid-core.min.js",
    "*.css"
  ],
  "exports": {
    "./core": "./dist/aigrid-core.min.js",
    "./core.css": "./dist/aigrid-core.min.css",
    "./react": {
      "types": "./dist/react/aigrid.d.ts",
      "import": "./dist/react/aigrid-react.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
